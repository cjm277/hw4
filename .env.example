# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit the real .env.

# Portkey API key used for all of the agent's model calls (OpenAI through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Model for the shop agent (OpenAI 5.6 / 6 series via Portkey). This project was built with gpt-5.6-luna.
OPENAI_MODEL=gpt-5.6-luna

# Optional: Portkey gateway URL (this is the default).
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
